{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["background.png"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js",
      "headers": {
        "Cache-Control": "public, s-maxage=3600, stale-while-revalidate=59"
      }
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
